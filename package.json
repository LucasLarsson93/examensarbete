{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "format:blade": "blade-formatter 'resources/views/**/*.blade.php'",
        "format:js": "prettier --write 'resources/js/**/*.js'",
        "format:css": "prettier --write 'resources/css/**/*.css'",
        "format": "npm run format:blade && npm run format:js && npm run format:css",
        "lint:js": "eslint 'resources/js/**/*.js'",
        "lint:css": "stylelint 'resources/css/**/*.css'",
        "lint": "npm run lint:js && npm run lint:css",
        "watch": "concurrently --kill-others 'npm run dev' 'npm run format' 'npm run lint'",
        "laravel-pint": "php artisan pint"
    },
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@tailwindcss/forms": "^0.5.2",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.6.4",
        "concurrently": "^9.0.1",
        "globals": "^16.0.0",
        "laravel-vite-plugin": "^1.0",
        "postcss": "^8.4.31",
        "sass": "^1.75.0",
        "tailwindcss": "^3.1.0",
        "vite": "^5.0"
    }
}
